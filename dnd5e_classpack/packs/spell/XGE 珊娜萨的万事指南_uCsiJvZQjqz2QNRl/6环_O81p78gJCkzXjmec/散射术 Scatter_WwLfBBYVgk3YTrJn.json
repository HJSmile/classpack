      "macro": {
        "name": "散射术 Scatter",
        "img": "icons/magic/light/projectile-beams-salvo-yellow.webp",
        "type": "script",
        "scope": "global",
        "command": "if (args[0]?.macroPass !== \"postActiveEffects\") return;\nconst cast = typeof workflow !== \"undefined\" ? workflow : null;\nconst api = game.modules.get(\"dnd5e_classpack\")?.api ?? globalThis.dnd5eClasspack;\nif (!cast || typeof api?.teleport !== \"function\") {\n  ui.notifications.warn(\"散射术：找不到施法流程或 ClassPack 传送接口。\");\n  return;\n}\nconst caster = cast.token ?? canvas.tokens.get(cast.tokenId);\nconst casterDoc = caster?.document ?? caster;\nconst scene = canvas.scene;\nif (!casterDoc || casterDoc.parent !== scene) return;\nconst targets = [...new Map(Array.from(cast.failedSaves ?? []).map(target => {\n  const doc = target.document ?? target;\n  return [doc.uuid, doc.object ?? target];\n})).values()];\nif (!targets.length) return;\nif (targets.length > 5) {\n  ui.notifications.warn(\"散射术最多影响 5 个生物，请重新选择目标。\");\n  return;\n}\n// 施法者也可能被传送；落点范围始终从施法时的位置计算。\nconst origin = { ...casterDoc.getCenterPoint(), elevation: casterDoc.elevation };\nconst range = game.dnd5e.utils.convertLength(120, \"ft\", scene.grid.units, { strict: false });\nlet moved = 0;\nfor (const target of targets) {\n  const doc = target.document ?? target;\n  if (canvas.scene !== scene || doc.parent !== scene || !scene.tokens.has(doc.id)) break;\n  ui.notifications.info(`散射术：为 ${doc.name} 选择可见、未占用且有地面支撑的落点（施法者 120 尺内）；右键取消后续传送。`);\n  try {\n    const result = await api.teleport([target], target, {\n      centerpoint: origin,\n      range,\n      avoidOccupied: true,\n      animation: \"none\",\n      animate: false,\n      crosshairsConfig: { label: `散射术 · ${doc.name}`, tag: \"classpack-scatter\" },\n      validityFunctions: [point => !casterDoc.object?.checkCollision(point, {\n        origin, type: \"sight\", mode: \"any\"\n      })]\n    });\n    if (!result || result.cancelled || !result.valid) break;\n    if (result.movement?.[doc.id] !== true) {\n      ui.notifications.warn(`散射术：${doc.name} 未能移动，已停止后续传送。`);\n      break;\n    }\n    moved++;\n  } catch (error) {\n    console.error(\"ClassPack 散射术传送失败\", error);\n    ui.notifications.error(\"散射术传送失败，请查看控制台。\");\n    break;\n  }\n}\nif (moved) ui.notifications.info(`散射术：已传送 ${moved} 个生物。`);\n",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
