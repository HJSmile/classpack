    "dae": {
      "macro": {
        "name": "炽焰赋权Investiture of Flame",
        "img": "icons/creatures/mammals/ox-bull-horned-glowing-orange.webp",
        "type": "script",
        "scope": "global",
        "command": "(async () => {\n  // 确认宏触发时 args[0] 存在“on”或“off”\n  const hook = args[0];\n  const tokenD = canvas.tokens.get(args[1]?.tokenId);\n  if (!tokenD) return;\n\n  if (hook === \"on\") {\n    // 效果创建时：立即造成 1d10火焰 伤害\n    const roll = await new Roll(\"1d10[fire]\").roll({async: true});\n    await new MidiQOL.DamageOnlyWorkflow(\n      actor,\n      token,\n      roll.total,\n      'fire',\n      tokenD ? [tokenD] : [],\n      roll,\n      { flavor: \"DAE Effect: Force Damage on creation\" }\n    );\n  }\n  // hook === \"off\" 时，无操作\n})();",
        "author": "WqWGW8MuBm7BNHxt",
