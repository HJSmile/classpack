        "scope": "global",
        "command": "const activity = macroItem.system.activities.find(a => a.type == 'save');\nconst actor = workflow.actor;\nconst token = workflow.token;\nif (workflow.item.type !== 'spell') return;\nconst target = new Set([token]);\nconst usage = {\n  consume: false,\n  midiOptions: {\n    ignoreUserTargets: true,\n    workflowData: true,\n    workflowOptions: {\n      targetsToUse: target,\n      autoConsumeResource: \"both\"\n    }\n  }\n};\nconst dialog = {create : false};\nconst SaveWorkflow = await MidiQOL.completeActivityUse(activity,usage,dialog);\nif (SaveWorkflow.failedSaves.has(token)){\n  workflow.aborted = true;\n}",
