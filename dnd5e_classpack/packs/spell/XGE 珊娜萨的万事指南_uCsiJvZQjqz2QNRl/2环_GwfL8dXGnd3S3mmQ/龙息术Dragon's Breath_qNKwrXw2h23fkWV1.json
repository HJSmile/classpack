    "dae": {
      "macro": {
        "name": "龙息术Dragon's Breath",
        "img": "icons/creatures/abilities/dragon-fire-breath-orange.webp",
        "type": "script",
        "scope": "global",
        "command": "(async () => {\n  const caster = actor;\n  const target = canvas.tokens.controlled[0]?.actor;\n  if (!caster || !target) return ui.notifications.warn(\"请选择施法者和目标\");\n\n  const saveDC = caster.system.attributes.spell.dc;\n  if (!saveDC) return ui.notifications.warn(\"未找到施法者的豁免 DC\");\n\n  const damageType = await new Promise(r => new Dialog({\n    title: \"选择伤害类型\",\n    content:`<form><label>类型：<select id=\"dt\">\n      <option value=\"fire\">火焰</option><option value=\"cold\">寒冷</option>\n      <option value=\"lightning\">闪电</option><option value=\"poison\">毒素</option>\n      <option value=\"acid\">酸性</option></select></label></form>`,\n    buttons:{ ok:{label:\"确定\",callback:h=>r(h.find(\"#dt\").val())}, cancel:{label:\"取消\",callback:()=>r(null)} },\n    default:\"ok\"\n  }).render(true));\n  if (!damageType) return ui.notifications.warn(\"未选择伤害类型\");\n\n  const spellLevel = await new Promise(r => new Dialog({\n    title: \"选择法术位环级\",\n    content:`<form><label>环级（最少 2）：<input id=\"lvl\" type=\"number\" min=\"2\" value=\"2\"></label></form>`,\n    buttons:{ ok:{label:\"确定\",callback:h=>r(parseInt(h.find(\"#lvl\").val())||3)}, cancel:{label:\"取消\",callback:()=>r(null)} },\n    default:\"ok\"\n  }).render(true));\n  if (!spellLevel) return ui.notifications.warn(\"未选择环级\");\n\n  const extraDice = Math.max(0, spellLevel - 2);\n\n  const item = target.items.find(i => i.name === \"龙息\");\n  if (!item) return ui.notifications.warn(\"目标无“龙息”物品\");\n\n  const formula = `3d6[${damageType}]${extraDice>0? `+${extraDice}d6`: \"\"}`;\n\n  await item.update({\n    [`system.activities.nt6z0FF53gKwBdeL.damage.parts`]: [{\n      custom: { enabled: false, formula: \"\" },\n      number: 3 + extraDice,\n      denomination: 6,\n      bonus: \"\",\n      types: [damageType],\n      scaling: { number: 1 }\n    }],\n    [`system.activities.nt6z0FF53gKwBdeL.save.dc.formula`]: saveDC.toString()\n  });\n\n  ui.notifications.info(`更新成功：类型 ${damageType}，伤害 ${formula}，豁免 DC ${saveDC}`);\n})();",
        "author": "WqWGW8MuBm7BNHxt",
