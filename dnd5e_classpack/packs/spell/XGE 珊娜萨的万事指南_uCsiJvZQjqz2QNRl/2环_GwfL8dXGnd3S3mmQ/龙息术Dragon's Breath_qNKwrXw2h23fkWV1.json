    "dae": {
      "macro": {
        "name": "龙息术Dragon's Breath",
        "img": "icons/creatures/abilities/dragon-fire-breath-orange.webp",
        "type": "script",
        "scope": "global",
        "command": "// 法术物品自带 OnUse 宏，挂载 postActiveEffects。目标为获得喷吐能力的生物。\nif (args[0].macroPass !== \"postActiveEffects\") return;\n\nconst caster = macroItem.actor;\nconst target = workflow.targets.first()?.actor;\nif (!target) return;\n\nconst damageType = await dnd5eClasspack.dialogUtils.selectDamageType(\n  [\"acid\", \"cold\", \"fire\", \"lightning\", \"poison\"],\n  macroItem.name, \"\",\n  { userId: dnd5eClasspack.firstOwner(caster, true) }\n);\nif (!damageType) return;\n\nconst effect = target.effects.find(e => e.system.origin?.message === workflow.itemCardUuid);\n\nconst dc = caster.system.abilities[workflow.activity.spellcastingAbility]?.dc\n  ?? caster.system.attributes.spell.dc;\nconst dice = workflow.spellLevel + 1;\nconst label = game.i18n.localize(CONFIG.DND5E.damageTypes[damageType].label);\nconst id = foundry.utils.randomID();\n\nawait dnd5eClasspack.createActorItems(target, [{\n  name: `${macroItem.name}：喷吐（${label}）`,\n  type: \"feat\", img: macroItem.img, effects: [],\n  flags: { dnd5e: { dependentOn: effect.uuid } },\n  system: {\n    properties: [\"mgc\"],\n    description: {\n      value: `<p>以一个动作喷吐 15 尺锥形的${label}能量。区域内生物进行 DC ${dc} 敏捷豁免，失败受到 ${dice}d6 ${label}伤害，成功则伤害减半。</p>`\n    },\n    activities: { [id]: {\n      _id: id, name: \"喷吐\", type: \"save\",\n      activation: { type: \"action\", cost: 1 },\n      consumption: { spellSlot: false, targets: [] },\n      range: { units: \"self\" },\n      target: {\n        prompt: true,\n        template: { type: \"cone\", size: \"15\", units: \"ft\", count: \"1\" },\n        affects: { type: \"creature\" }\n      },\n      save: { ability: [\"dex\"], dc: { calculation: \"\", formula: String(dc) } },\n      damage: {\n        onSave: \"half\",\n        parts: [{ number: dice, denomination: 6, bonus: \"\", types: [damageType] }]\n      }\n    } }\n  }\n}], { favorite: true });",
        "author": "dvg25zW2MvzsvMOU",
        "ownership": {
          "default": 3
        },
