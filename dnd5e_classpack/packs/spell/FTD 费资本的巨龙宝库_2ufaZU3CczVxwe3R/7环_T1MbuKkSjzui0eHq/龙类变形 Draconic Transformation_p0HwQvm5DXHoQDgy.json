    "dae": {
      "macro": {
        "name": "龙类变形 Draconic Transformation",
        "img": "icons/creatures/abilities/dragon-fire-breath-orange.webp",
        "type": "script",
        "scope": "global",
        "command": "if (args[0] === \"off\") {\n  const state = args.at(-1).efData.flags.world?.draconicTransformation;\n  if (!state) return;\n  const spell = await fromUuid(state.item);\n  await dnd5eClasspack.hideActivity(`${spell.uuid}.Activity.${state.activity}`);\n  if (state.favoriteAdded) await spell.actor.system.removeFavorite(state.favorite);\n  return;\n}\n\nif (args[0].macroPass !== \"postActiveEffects\") return;\n\nconst spell = await fromUuid(macroItem.uuid);\nconst breath = spell.system.activities.find(a => a.name === \"吐息武器\");\nif (workflow.activity.id === breath.id) return;\n\nconst effect = spell.actor.effects.find(e => e.system?.origin?.message === workflow.itemCardUuid);\nif (!effect) {\n  ui.notifications.warn(\"龙类变形：未找到本次施法应用的自身效果。\");\n  return;\n}\nconst favorite = `${foundry.utils.buildRelativeUuid(spell, spell.actor)}.Activity.${breath.id}`;\nawait effect.setFlag(\"world\", \"draconicTransformation\", {\n  item: spell.uuid, activity: breath.id, favorite,\n  favoriteAdded: !spell.actor.system.hasFavorite(favorite)\n});\n\nawait spell.update({ [`system.activities.${breath.id}.visibility.level.max`]: null });\nawait dnd5eClasspack.hideActivity(breath.uuid, false);\nawait dnd5eClasspack.addFavorite(breath.uuid);",
        "author": "dvg25zW2MvzsvMOU",
        "ownership": {
          "default": 3
        },
