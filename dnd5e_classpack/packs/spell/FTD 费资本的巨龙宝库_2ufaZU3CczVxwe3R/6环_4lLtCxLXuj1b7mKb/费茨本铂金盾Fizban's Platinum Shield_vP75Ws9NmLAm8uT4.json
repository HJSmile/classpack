    "dnd5e": {},
    "dae": {
      "macro": {
        "name": "费兹本铂金盾Fizban's Platinum Shield",
        "img": "icons/equipment/shield/heater-steel-gray.webp",
        "type": "script",
        "scope": "global",
        "command": "// 原法术物品挂载 preItemRoll、postActiveEffects；力场 AE 添加 macro.itemMacro。\nconst spell = await fromUuid(macroItem.uuid);\nconst move = spell.system.activities.find(a => a.name === \"转移力场\");\nconst state = spell.getFlag(\"world\", \"platinumShield\");\n\nif (args[0] === \"off\") {\n  if (state?.effect !== args.at(-1).effectUuid) return;\n  await dnd5eClasspack.hideActivity(move.uuid);\n  if (state.favoriteAdded) await spell.actor.system.removeFavorite(state.favorite);\n  await spell.unsetFlag(\"world\", \"platinumShield\");\n  return;\n}\n\nconst pass = args[0].macroPass;\nif (![\"preItemRoll\", \"postActiveEffects\"].includes(pass)) return;\n\nif (workflow.activity.id !== move.id) {\n  if (pass !== \"postActiveEffects\") return;\n  const target = workflow.targets.first();\n  const effect = target.actor.effects.find(e => e.system?.origin?.message === workflow.itemCardUuid);\n  if (!effect) {\n    ui.notifications.warn(\"铂金之盾：未找到本次施法应用的力场效果。\");\n    return;\n  }\n  const favorite = `${foundry.utils.buildRelativeUuid(spell, spell.actor)}.Activity.${move.id}`;\n  await spell.setFlag(\"world\", \"platinumShield\", {\n    effect: effect.uuid, token: target.document.uuid, favorite,\n    favoriteAdded: !spell.actor.system.hasFavorite(favorite)\n  });\n  await dnd5eClasspack.hideActivity(move.uuid, false);\n  await dnd5eClasspack.addFavorite(move.uuid);\n  return;\n}\n\nif (pass === \"preItemRoll\") {\n  const current = state && (await fromUuid(state.token))?.object;\n  const effect = state && await fromUuid(state.effect);\n  if (!current || !effect?.active) {\n    ui.notifications.warn(\"铂金之盾：当前没有可转移的力场。\");\n    return false;\n  }\n  const targets = MidiQOL.findNearby(workflow.token.document.disposition, current, 60, {\n    relative: false, includeIncapacitated: true, includeToken: false\n  });\n  if (!targets.length) {\n    ui.notifications.warn(\"铂金之盾：力场周围 60 尺内没有可选择的盟友。\");\n    return false;\n  }\n  const [target] = await dnd5eClasspack.dialogUtils.selectTargetDialog(\n    \"转移力场\", \"\", targets,\n    { userId: dnd5eClasspack.firstOwner(spell.actor, true), skipDeadAndUnconscious: false }\n  );\n  if (!target) return false;\n  workflow.platinumShieldTarget = target.document.uuid;\n  return;\n}\n\nconst effect = await fromUuid(state.effect);\nconst target = await fromUuid(workflow.platinumShieldTarget);\nconst data = effect.toObject();\ndata._id = foundry.utils.randomID();\n\nawait MidiQOL.socket().executeAsGM(\"createEffects\", {\n  actorUuid: target.actor.uuid, effects: [data], options: { keepId: true }\n});\n// 先指向新效果，再删除旧效果；旧效果的 off 因 UUID 不匹配而跳过清理。\nawait spell.setFlag(\"world\", \"platinumShield\", {\n  ...state, effect: `${target.actor.uuid}.ActiveEffect.${data._id}`, token: target.uuid\n});\nawait MidiQOL.socket().executeAsGM(\"removeEffects\", {\n  actorUuid: effect.parent.uuid, effects: [effect.id]\n});",
        "author": "dvg25zW2MvzsvMOU",
        "ownership": {
          "default": 3
        },
