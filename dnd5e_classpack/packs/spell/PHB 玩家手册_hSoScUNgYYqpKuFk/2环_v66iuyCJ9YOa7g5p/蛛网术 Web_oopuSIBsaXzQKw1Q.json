        "macroData": {
          "name": "区域豁免与束缚来源",
          "command": "const cfg = workflow.item.flags.dnd5e_classpack.regionAutomation;\nconst pass = args[0]?.macroPass;\nfunction ownEffect(effect, role) {\n  if (effect.flags?.dnd5e_classpack?.regionEffect !== role) return false;\n  const itemUuid = workflow.item.uuid;\n  return [effect.origin, ...Object.values(effect.system?.origin ?? {}),\n    effect._stats?.duplicateSource, effect.flags?.dnd5e_classpack?.sourceItemUuid]\n    .some(uuid => typeof uuid === \"string\" &&\n      (uuid === itemUuid || uuid.startsWith(itemUuid + \".\")));\n}\nfunction concentration() {\n  return MidiQOL.getConcentrationEffect(workflow.actor, workflow.item)\n    ?? MidiQOL.getConcentrationEffect(workflow.actor);\n}\nconst role = cfg.key + \"-binding\";\nif (pass === \"preItemRoll\") {\n  const target = Array.from(workflow.targets ?? [])[0];\n  if (!target?.actor) return false;\n  if (cfg.key === \"web\" && game.combat?.active &&\n    game.combat.combatant?.token?.uuid !== (target.document ?? target).uuid) return false;\n  if (cfg.key === \"blackTentacles\" && Array.from(target.actor.appliedEffects ?? target.actor.effects)\n    .some(effect => !effect.disabled && !effect.isSuppressed && ownEffect(effect, role))) return false;\n}\nif (pass === \"postActiveEffects\") {\n  const dependentOn = concentration()?.uuid;\n  for (const target of workflow.targets ?? []) {\n    const updates = Array.from(target.actor?.appliedEffects ?? target.actor?.effects ?? [])\n      .filter(effect => ownEffect(effect, role)).map(effect => ({ _id: effect.id,\n        \"flags.dnd5e_classpack.sourceItemUuid\": workflow.item.uuid,\n        ...(dependentOn ? { \"flags.dnd5e.dependentOn\": dependentOn } : {})\n      }));\n    if (updates.length) await MidiQOL.socket().executeAsGM(\"updateEffects\", {\n      actorUuid: target.actor.uuid, updates\n    });\n  }\n}\n"
        },
