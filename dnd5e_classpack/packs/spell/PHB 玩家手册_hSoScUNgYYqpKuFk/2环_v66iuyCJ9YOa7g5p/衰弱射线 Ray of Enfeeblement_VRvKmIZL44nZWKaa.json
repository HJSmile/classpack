    "dae": {
      "macro": {
        "name": "衰弱射线 Ray of Enfeeblement",
        "img": "icons/magic/light/beam-rays-teal.webp",
        "type": "script",
        "scope": "global",
        "command": "if (workflow.isFumble || workflow.item.type !== \"weapon\") return;\nif (workflow.attackRoll?.options.ability !== \"str\") return;\n\nconst rolls = workflow.damageRolls.map(roll =>\n  new CONFIG.Dice.DamageRoll(\n    `floor(${roll.total} / 2)`,\n    roll.data,\n    { ...roll.options, configured: true }\n  )\n);\n\nawait workflow.setDamageRolls(rolls);",
        "author": "dvg25zW2MvzsvMOU",
