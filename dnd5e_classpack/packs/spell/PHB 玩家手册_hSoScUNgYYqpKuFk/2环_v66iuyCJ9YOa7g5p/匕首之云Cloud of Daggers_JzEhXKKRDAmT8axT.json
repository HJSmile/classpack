        "useConditionText": "",
        "useConditionReason": "",
        "effectConditionText": "",
        "macroData": {
          "name": "Midi伤害",
          "command": "if (args[0].macroPass !== \"templatePlaced\") return;\n\nfor (const uuid of workflow.templateUuids) {\n  const region = await fromUuid(uuid);\n  if (region?.documentName !== \"Region\") continue;\n\n  const behavior = region.behaviors.find(b =>\n    b.type === \"midi-qol.regionActivity\" &&\n    b.system.sourceItemUuid === workflow.item.uuid\n  );\n  if (!behavior) continue;\n\n  const rules = foundry.utils.deepClone(behavior.system.rules);\n  const turnEnd = rules.find(r =>\n    r.trigger === \"turnEnd\" && r.action === \"useActivity\"\n  );\n  if (!turnEnd) continue;\n  console.log(turnEnd)\n\n  // 已有相同 Entry 规则时，不重复添加。\n  if (rules.some(r =>\n    r.trigger === \"entry\" &&\n    r.action === \"useActivity\" &&\n    r.targetUuid === turnEnd.targetUuid\n  )) continue;\n\n  rules.push({\n    trigger: \"entry\",\n    action: \"useActivity\",\n    targetUuid: turnEnd.targetUuid\n  });\n\n  await MidiQOL.socket().executeAsGM(\"setupRegion\", {\n    regionUuid: region.uuid,\n    update: {\n      behaviors: [{\n        _id: behavior.id,\n        system: { rules }\n      }]\n    }\n  });\n};\nif (args[0].macroPass !== \"postSave\") return;\n\nconst combat = game.combat;\nif (!combat?.active) return;\n\n// 成功和失败都算已经触发；按角色去重。\nconst actorIds = new Set(\n  [...workflow.saves, ...workflow.failedSaves]\n    .map(token => token.actor?.id)\n    .filter(Boolean)\n);\nif (!actorIds.size) return;\n\nconst turn = `${combat.round}.${combat.turn}`;\n\nfor (const uuid of workflow.templateUuids) {\n  const region = await fromUuid(uuid);\n  if (region?.documentName !== \"Region\") continue;\n\n  const behavior = region.behaviors.find(b =>\n    b.type === \"midi-qol.regionActivity\" &&\n    b.system.sourceItemUuid === workflow.item.uuid &&\n    b.system.oncePerTurn\n  );\n  if (!behavior) continue;\n\n  // 登记到区域后续使用的豁免活动，而非初次施法活动。\n  const entry = behavior.system.rules.find(r =>\n    r.trigger === \"entry\" && r.action === \"useActivity\"\n  );\n  if (!entry?.targetUuid) continue;\n\n  const activityKey = entry.targetUuid.split(\".\").at(-1);\n\n  for (const actorId of actorIds) {\n    const key =\n      `regionTriggers.${behavior.id}.${actorId}-${activityKey}`;\n\n    if (game.user.isGM) {\n      await combat.setFlag(\"midi-qol\", key, turn);\n    } else {\n      // 当前版本的此接口也支持通过 UUID 修改 Combat。\n      await MidiQOL.socket().executeAsGM(\"_gmSetFlag\", {\n        actorUuid: combat.uuid,\n        base: \"midi-qol\",\n        key,\n        value: turn\n      });\n    }\n  }\n}"
        },
