        "macroData": {
          "name": "Midi豁免",
          "command": "const pass = args[0]?.macroPass;\nif (![\"templatePlaced\", \"postSave\"].includes(pass)) return;\n\nconst combat = game.combat;\nif (pass === \"postSave\" && !combat?.active) return;\n\nconst actorIds = pass === \"postSave\"\n  ? new Set(\n      [...(workflow.saves ?? []), ...(workflow.failedSaves ?? [])]\n        .map(token => token.actor?.id)\n        .filter(Boolean)\n    )\n  : new Set();\n\nif (pass === \"postSave\" && !actorIds.size) return;\n\nfor (const uuid of workflow.templateUuids ?? []) {\n  const region = await fromUuid(uuid);\n  if (region?.documentName !== \"Region\") continue;\n\n  const behavior = region.behaviors.find(b =>\n    b.type === \"midi-qol.regionActivity\" &&\n    b.system.sourceItemUuid === workflow.item.uuid\n  );\n  if (!behavior) continue;\n\n  const rules = foundry.utils.deepClone(behavior.system.rules);\n  const turnEnd = rules.find(r =>\n    r.trigger === \"turnEnd\" && r.action === \"useActivity\"\n  );\n  if (!turnEnd?.targetUuid) continue;\n\n  if (pass === \"templatePlaced\") {\n    // 不论是否开启 Once per Turn，都补上 Entry。\n    if (rules.some(r =>\n      r.trigger === \"entry\" &&\n      r.action === \"useActivity\" &&\n      r.targetUuid === turnEnd.targetUuid\n    )) continue;\n\n    rules.push({\n      trigger: \"entry\",\n      action: \"useActivity\",\n      targetUuid: turnEnd.targetUuid\n    });\n\n    await MidiQOL.socket().executeAsGM(\"setupRegion\", {\n      regionUuid: region.uuid,\n      update: {\n        behaviors: [{ _id: behavior.id, system: { rules } }]\n      }\n    });\n    continue;\n  }\n\n  // postSave：只有开启 Once per Turn，才登记初次豁免。\n  if (!behavior.system.oncePerTurn) continue;\n\n  const activityKey = turnEnd.targetUuid.split(\".\").at(-1);\n  const turn = `${combat.round}.${combat.turn}`;\n\n  for (const actorId of actorIds) {\n    const key = `regionTriggers.${behavior.id}.${actorId}-${activityKey}`;\n\n    if (game.user.isGM) {\n      await combat.setFlag(\"midi-qol\", key, turn);\n    } else {\n      // 当前版本的此接口也支持通过 UUID 修改 Combat。\n      await MidiQOL.socket().executeAsGM(\"_gmSetFlag\", {\n        actorUuid: combat.uuid,\n        base: \"midi-qol\",\n        key,\n        value: turn\n      });\n    }\n  }\n}"
        },
