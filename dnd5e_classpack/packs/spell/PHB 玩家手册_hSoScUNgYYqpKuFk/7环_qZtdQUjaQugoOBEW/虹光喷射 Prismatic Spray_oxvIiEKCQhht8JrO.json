{
  "_id": "oxvIiEKCQhht8JrO",
  "name": "虹光喷射 Prismatic Spray",
  "type": "spell",
  "flags": {
    "midi-qol": {
      "AoETargetType": "any",
      "AoETargetTypeIncludeSelf": true,
      "autoTarget": "default",
      "rollAttackPerTarget": "always",
