    "dnd5e": {},
    "dae": {
      "macro": {
        "name": "虹光喷射 Prismatic Spray",
        "img": "icons/magic/control/buff-luck-fortune-rainbow.webp",
        "type": "script",
        "scope": "global",
        "command": "// RainbowSpray_Simplified_StrictA\n(async () => {\n  try {\n    const a = args?.[0] ?? {};\n    const item = a.item ?? a.itemData ?? null;\n    const caster = a.actor ?? (a.token ? canvas.tokens.get(a.token.id)?.actor : undefined) ?? game.actors.get(a.actor?._id);\n    const casterToken = canvas.tokens.get(a.token?.id) ?? canvas.tokens.controlled[0] ?? canvas.tokens.placeables.find(t => t.actor?.id === caster?.id);\n\n    if (!caster) { ui.notifications.error(\"RainbowSpray: 无法找到施法者\"); return true; }\n\n    // 收集目标\n    let targets = [];\n    if (Array.isArray(a?.targets) && a.targets.length) targets = a.targets.map(t => canvas.tokens.get(t.id ?? t.document?.id)).filter(Boolean);\n    else if (Array.isArray(a?.targetUuids) && a.targetUuids.length) {\n      for (const u of a.targetUuids) { try { const d = await fromUuid(u); if (d?.documentName === \"Token\") targets.push(canvas.tokens.get(d.id)); } catch {} }\n    } else targets = Array.from(game.user.targets);\n    if (!targets.length) { ui.notifications.warn(\"RainbowSpray: 未选中目标\"); return true; }\n\n    // 计算 DC（优先 item/system/actor 的设定）\n    const computeSpellDC = (actorObj, itemObj) => {\n      try { if (itemObj?.system?.save?.dc) return Number(itemObj.system.save.dc); } catch {}\n      try { const aDC = actorObj?.system?.attributes?.spell?.dc ?? actorObj?.system?.attributes?.spelldc; if (aDC) return Number(aDC); } catch {}\n      const abil = itemObj?.system?.ability ?? Object.keys(actorObj.system.abilities)[0];\n      const abilMod = Number(actorObj?.system?.abilities?.[abil]?.mod ?? 0);\n      const prof = Number(actorObj?.system?.attributes?.prof ?? actorObj?.system?.attributes?.proficiency ?? 0);\n      const itemBonus = Number(itemObj?.system?.save?.bonus ?? 0);\n      return 8 + abilMod + prof + itemBonus;\n    };\n    const spellDC = computeSpellDC(caster, item);\n\n    const colorMap = {\n      1:{type:\"fire\",label:\"红 (fire)\"},\n      2:{type:\"acid\",label:\"橙 (acid)\"},\n      3:{type:\"lightning\",label:\"黄 (lightning)\"},\n      4:{type:\"poison\",label:\"绿 (poison)\"},\n      5:{type:\"cold\",label:\"蓝 (cold)\"},\n      6:{type:\"petrify\",label:\"靛 (petrify)\"},\n      7:{type:\"blind\",label:\"紫 (blind)\"},\n      8:{type:\"special\",label:\"特殊 (special)\"}\n    };\n\n    // 全场一次 10d6\n    const globalRoll = await new Roll(\"10d6\").roll();\n    const globalTotal = Number(globalRoll.total);\n    await globalRoll.toMessage({ flavor: `虹光喷射 — 全场伤害掷骰 = ${globalTotal}` });\n\n    // helper: roll d8 (special) 并公告\n    const rollD8 = async tk => {\n      let r = await new Roll(\"1d8\").roll();\n      if (r.total === 8) { r = await new Roll(\"1d8\").roll(); if (r.total === 8) r = await new Roll(\"1d8\").roll(); }\n      ChatMessage.create({ content: `${tk.name} 被判定为: <b>${(colorMap[r.total]?.label) ?? r.total}</b> (d8=${r.total})`, speaker: ChatMessage.getSpeaker({ actor: caster }) });\n      return r.total;\n    };\n\n    // doDexSave（严格版：仅使用系统提供的豁免方法；若两者都不存在则抛出）\n    const doDexSave = async actorTarget => {\n      if (typeof actorTarget.rollSavingThrow === \"function\") return await actorTarget.rollSavingThrow(\"dex\", { fastForward: false, chatMessage: true });\n      if (typeof actorTarget.rollAbilitySave === \"function\") return await actorTarget.rollAbilitySave(\"dex\", { fastForward: false, chatMessage: true });\n      console.error(`RainbowSpray: ${actorTarget.name} 不支持 rollSavingThrow/rollAbilitySave（严格模式）`);\n      ChatMessage.create({ content: `RainbowSpray: 错误 — 目标 ${actorTarget.name} 不支持标准豁免方法，请检查该 Actor 配置。` });\n      throw new Error(\"Target actor lacks saving throw API\");\n    };\n\n    // apply item AE to target (for petrify / blind)\n    const applyItemAEToTarget = async (targetActor, keywords=[]) => {\n      if (!item?.effects?.length) return false;\n      const found = item.effects.find(ef => {\n        const nm = String(ef.name ?? ef.label ?? ef.data?.name ?? \"\").toLowerCase();\n        return keywords.some(k => nm.includes(k));\n      });\n      if (!found) return false;\n      const data = found.toObject ? found.toObject() : duplicate(found);\n      if (data._id) delete data._id;\n      data.origin = a.uuid ?? a.itemUuid ?? item?.uuid ?? data.origin;\n      await targetActor.createEmbeddedDocuments(\"ActiveEffect\", [data]);\n      return true;\n    };\n\n    // 主循环（严格/无回退）\n    for (const tk of targets) {\n      if (!tk?.actor) continue;\n      const tgtActor = tk.actor;\n      const d8 = await rollD8(tk);\n      const color = colorMap[d8] ?? colorMap[8];\n\n      // 强制使用系统豁免方法（严格）\n      const save = await doDexSave(tgtActor);\n      const saveTotal = Number(save?.total ?? save?.results?.[0]?.result ?? -9999);\n      const saved = saveTotal >= spellDC;\n\n      // petrify / blind: copy AE from item\n      if (color.type === \"petrify\" || color.type === \"blind\") {\n        if (!saved) {\n          const ok = await applyItemAEToTarget(tgtActor, color.type === \"petrify\" ? [\"petr\",\"indigo\"] : [\"violet\",\"blind\"]);\n          if (!ok) ChatMessage.create({ content: `${tgtActor.name} 未找到对应 AE（请在施法物品上添加）` });\n          else ChatMessage.create({ content: `${tgtActor.name} 未通过豁免，已应用 ${color.label}` });\n        } else {\n          ChatMessage.create({ content: `${tgtActor.name} 豁免成功，未触发 ${color.label}` });\n        }\n        continue;\n      }\n\n      // 普通伤害色（1-5）\n      if ([\"fire\",\"acid\",\"lightning\",\"poison\",\"cold\"].includes(color.type)) {\n        const applied = saved ? Math.floor(globalTotal/2) : globalTotal;\n        const typed = new Roll(`${applied}[${color.type}]`);\n        if (typeof typed.evaluateSync === \"function\") typed.evaluateSync(); else await typed.roll();\n\n        try {\n          await new MidiQOL.DamageOnlyWorkflow(caster, casterToken, applied, color.type, [tk], typed, {\n            flavor: `${item?.name ?? \"Rainbow Spray\"} — ${color.label}`,\n            itemCardId: a.itemCardId ?? a.itemCardUUID ?? null,\n            itemData: duplicate(item) ?? {},\n            useOther: false\n          });\n          // 成功时正常继续（不做其它回退）\n        } catch (err) {\n          console.error(\"RainbowSpray: DamageOnlyWorkflow failed for\", tk.name, err);\n          ChatMessage.create({ content: `自动应用伤害失败：请 GM 手动应用 ${applied} ${color.type} 到 ${tk.name}` });\n        }\n      }\n    }\n\n    return true;\n  } catch (e) {\n    console.error(\"RainbowSpray strict error\", e);\n    return true;\n  }\n})();",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
