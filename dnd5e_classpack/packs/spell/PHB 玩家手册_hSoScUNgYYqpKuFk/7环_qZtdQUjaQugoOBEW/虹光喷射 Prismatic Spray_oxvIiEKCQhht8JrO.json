    "dnd5e": {},
    "dae": {
      "macro": {
        "name": "虹光喷射 Prismatic Spray",
        "img": "icons/magic/control/buff-luck-fortune-rainbow.webp",
        "type": "script",
        "scope": "global",
        "command": "const colors = [null,\n  { name: \"红\", type: \"fire\" }, { name: \"橙\", type: \"acid\" },\n  { name: \"黄\", type: \"lightning\" }, { name: \"绿\", type: \"poison\" },\n  { name: \"蓝\", type: \"cold\" }, { name: \"靛\" }, { name: \"紫\" }\n];\n\nif (args[0] === \"off\") {\n  const data = args.at(-1);\n  if (args[1] !== \"violet\" || data[\"expiry-reason\"] !== \"duration-expired:sourceStart\") return;\n  const affected = await fromUuid(data.actorUuid);\n  const dc = Number(args[2]);\n  const owner = game.users.find(u => u.active && !u.isGM && affected.testUserPermission(u, \"OWNER\"))\n    ?? game.users.activeGM ?? game.user;\n  const rolls = await MidiQOL.socket().executeAsUser(\"rollAbility\", owner.id, {\n    saveDetails: {\n      actorUuid: affected.uuid, rollType: \"save\", rollAbilities: [\"wis\"],\n      rollDC: dc, isMagicSave: true, saveItemUuid: macroItem.uuid,\n      workflowOptions: {}, itemCardUuid: \"\"\n    },\n    displayOptions: { fastForward: true, chatMessage: true }\n  });\n  if (!Array.isArray(rolls) || !rolls.length) {\n    ui.notifications.warn(\"虹光喷射：感知豁免未完成，请手动处理。\");\n    return;\n  }\n  const total = rolls.reduce((sum, r) => sum + (r.total ?? r._total ?? 0), 0);\n  if (total < dc) await foundry.documents.ChatMessage.implementation.create({\n    speaker: foundry.documents.ChatMessage.getSpeaker({ actor: affected }),\n    content: `<p><strong>${foundry.utils.escapeHTML(affected.name)}</strong> 感知豁免失败，被传送至 DM 指定的位面。目盲已结束。</p>`\n  });\n  return;\n}\nif (typeof args[0] === \"string\") return;\n\nconst pass = args[0].macroPass;\nconst effectUse = workflow.workflowOptions.prismaticEffect;\n\n// Utility 正常应用预配置 AE；只补充本次主行动的 DC 上下文。\nif (effectUse) {\n  if (pass === \"preActiveEffects\") {\n    const getRollData = workflow.activity.getRollData.bind(workflow.activity);\n    workflow.activity.getRollData = function () {\n      const data = getRollData();\n      data.activity.prismaticDC = effectUse.dc;\n      return data;\n    };\n  }\n  return;\n}\nif (!workflow.activity.save?.ability.has(\"dex\")) return;\n\nfunction typedRoll(roll, type) {\n  const copy = Roll.fromJSON(roll.toJSON());\n  copy.options.type = type;\n  copy.options.types = [type];\n  return copy;\n}\n\nif (pass === \"postSave\") {\n  if (workflow.prismaticSpray) return;\n  const state = workflow.prismaticSpray = {\n    dc: workflow.activity.save.dc.value, rays: new Map(), dice: []\n  };\n  for (const target of workflow.targets) {\n    const first = await new Roll(\"1d8\", {}, { flavor: `${target.name}：射线` }).evaluate();\n    state.dice.push(first);\n    const rays = [];\n    if (first.total === 8) {\n      for (let i = 0; i < 2; i++) {\n        let roll;\n        do {\n          roll = await new Roll(\"1d8\", {}, { flavor: `${target.name}：额外射线 ${i + 1}` }).evaluate();\n          state.dice.push(roll);\n        } while (roll.total === 8);\n        rays.push(roll.total);\n      }\n    } else rays.push(first.total);\n    state.rays.set(target.document.uuid, rays);\n  }\n\n  // 只覆盖本次工作流实例。各组沿用原生伤害阶段，反应检查看到实际类型。\n  const damageStage = workflow.WorkflowState_AllRollsComplete;\n  workflow.WorkflowState_AllRollsComplete = async function WorkflowState_AllRollsComplete(context) {\n    this.WorkflowState_AllRollsComplete = damageStage;\n    const original = {\n      targets: this.targets, hitTargets: this.hitTargets, hitTargetsEC: this.hitTargetsEC,\n      parts: this.activity.damage.parts[0].types, defaultType: this.defaultDamageType,\n      rolls: this.damageRolls\n    };\n    const groups = new Map();\n    for (const target of original.targets) {\n      const types = state.rays.get(target.document.uuid).filter(n => n <= 5).map(n => colors[n].type);\n      if (!types.length) continue;\n      const key = types.join(\"+\");\n      if (!groups.has(key)) groups.set(key, { types, targets: new Set() });\n      groups.get(key).targets.add(target);\n    }\n    const base = original.rolls[0];\n    const extra = [...groups.values()].some(g => g.types.length === 2)\n      ? await new CONFIG.Dice.DamageRoll(base.formula, this.activity.getRollData(), { ...base.options }).evaluate()\n      : null;\n    const damages = [];\n    for (const group of groups.values()) {\n      this.targets = group.targets;\n      this.hitTargets = new Set([...original.hitTargets].filter(t => group.targets.has(t)));\n      this.hitTargetsEC = new Set([...original.hitTargetsEC].filter(t => group.targets.has(t)));\n      this.activity.damage.parts[0].types = new Set([group.types[0]]);\n      this.defaultDamageType = group.types[0];\n      await this.setDamageRolls(group.types.map((type, i) => typedRoll(i ? extra : base, type)));\n      await damageStage.call(this, context);\n      damages.push(...this.damageList);\n    }\n    this.targets = original.targets;\n    this.hitTargets = original.hitTargets;\n    this.hitTargetsEC = original.hitTargetsEC;\n    this.activity.damage.parts[0].types = original.parts;\n    this.defaultDamageType = original.defaultType;\n    // 主卡显示通用伤害骰；每组伤害卡及射线表显示实际颜色。\n    await this.setDamageRolls([typedRoll(base, \"none\"), ...(extra ? [typedRoll(extra, \"none\")] : [])]);\n    await this.displayDamageRolls();\n    this.damageList = damages;\n    this.damageItem = damages.at(-1);\n    return this.WorkflowState_ApplyDynamicEffects;\n  };\n\n  // 特殊时限的 isDamaged.fire 等也按目标实际收到的伤害类型处理。\n  const expire = workflow.expireTargetEffects;\n  workflow.expireTargetEffects = async function (list) {\n    const targets = this.targets, raw = this.rawDamageDetail;\n    for (const target of targets) {\n      this.targets = new Set([target]);\n      this.rawDamageDetail = this.damageList?.find(d => d.targetUuid === target.document.uuid)?.rawDamageDetail ?? [];\n      await expire.call(this, list);\n    }\n    this.targets = targets;\n    this.rawDamageDetail = raw;\n  };\n  return;\n}\n\nif (pass !== \"postActiveEffects\" || !workflow.prismaticSpray || workflow.prismaticSpray.finished) return;\nconst state = workflow.prismaticSpray;\nstate.finished = true;\nconst indigo = macroItem.system.activities.find(a => a.name === \"靛色射线\");\nconst violet = macroItem.system.activities.find(a => a.name === \"紫色射线\");\nconst rows = [];\nfor (const target of workflow.targets) {\n  const rays = state.rays.get(target.document.uuid);\n  rows.push(`<tr><td>${foundry.utils.escapeHTML(target.name)}</td><td>${rays.map(n => colors[n].name).join(\"＋\")}</td><td>${workflow.saves.has(target) ? \"成功\" : \"失败\"}</td></tr>`);\n  if (!workflow.failedSaves.has(target)) continue;\n  for (const [color, activity] of [[6, indigo], [7, violet]]) {\n    if (!rays.includes(color)) continue;\n    await MidiQOL.completeActivityUse(activity.uuid, {\n      consume: false,\n      midiOptions: {\n        targetUuids: [target.document.uuid], ignoreUserTargets: true,\n        workflowOptions: { prismaticEffect: { dc: state.dc }, onlyOnUseItemMacros: true }\n      }\n    }, { configure: false });\n  }\n}\nawait foundry.documents.ChatMessage.implementation.create({\n  speaker: foundry.documents.ChatMessage.getSpeaker({ actor: workflow.actor, token: workflow.token?.document }),\n  content: `<table><thead><tr><th>目标</th><th>射线</th><th>敏捷豁免</th></tr></thead><tbody>${rows.join(\"\")}</tbody></table>`,\n  rolls: state.dice,\n  whisper: workflow.chatCard?.whisper ?? [], blind: workflow.chatCard?.blind ?? false\n});",
        "author": "dvg25zW2MvzsvMOU",
