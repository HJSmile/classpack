    "dnd5e": {},
    "dae": {
      "macro": {
        "name": "克敌机先 True Strike",
        "type": "script",
        "command": "const pass = args[0]?.macroPass;\nconst dataKey = Symbol.for(\"dnd5e_classpack.trueStrike.rollData\");\nif (pass === \"preActiveEffects\") {\n  const item = workflow.item;\n  const previous = item[dataKey] ?? item.getRollData;\n  const combat = game.combat;\n  const captured = { inCombat: Boolean(combat?.active), round: combat?.round ?? 0, turn: combat?.turn ?? -1 };\n  item[dataKey] = previous;\n  item.getRollData = function (...options) {\n    return { ...previous.apply(this, options), trueStrike: captured };\n  };\n  return;\n}\nif (pass === \"postActiveEffects\") {\n  const item = workflow.item;\n  if (item[dataKey]) {\n    item.getRollData = item[dataKey];\n    delete item[dataKey];\n  }\n  return;\n}\nif (pass !== \"isAttacked\" || !workflow.attackRoll) return;\nconst context = MidiQOL.createConditionData({ workflow, actor: workflow.actor, target: workflow.token });\nfor (const target of workflow.targets) {\n  const effects = target.actor?.appliedEffects.filter(effect => {\n    if (effect.disabled || effect.isSuppressed || !effect.flags.dnd5e_classpack?.trueStrike) return false;\n    const change = effect.system.changes.find(c => c.key === \"flags.midi-qol.grants.advantage.attack.all\");\n    return change && MidiQOL.evalCondition(change.value, context, { errorReturn: false });\n  }) ?? [];\n  if (!effects.length) continue;\n  await MidiQOL.socket().executeAsGM(\"removeEffects\", {\n    actorUuid: target.actor.uuid,\n    effects: effects.map(effect => effect.id),\n    options: { \"expiry-reason\": \"midi-qol:trueStrikeAttack\" }\n  });\n}\n"
      }
    }
  },
