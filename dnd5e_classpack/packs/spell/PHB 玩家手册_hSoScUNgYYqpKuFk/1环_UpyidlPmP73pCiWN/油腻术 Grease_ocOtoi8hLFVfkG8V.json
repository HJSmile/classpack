        "otherActivityId": "none",
        "macroData": {
          "name": "Midi豁免",
          "command": "if (args[0].macroPass !== \"templatePlaced\") return;\n\nfor (const uuid of workflow.templateUuids) {\n  const region = await fromUuid(uuid);\n  if (region?.documentName !== \"Region\") continue;\n\n  const behavior = region.behaviors.find(b =>\n    b.type === \"midi-qol.regionActivity\" &&\n    b.system.sourceItemUuid === workflow.item.uuid\n  );\n  if (!behavior) continue;\n\n  const rules = foundry.utils.deepClone(behavior.system.rules);\n  const turnEnd = rules.find(r =>\n    r.trigger === \"turnEnd\" && r.action === \"useActivity\"\n  );\n  if (!turnEnd) continue;\n  console.log(turnEnd)\n\n  // 已有相同 Entry 规则时，不重复添加。\n  if (rules.some(r =>\n    r.trigger === \"entry\" &&\n    r.action === \"useActivity\" &&\n    r.targetUuid === turnEnd.targetUuid\n  )) continue;\n\n  rules.push({\n    trigger: \"entry\",\n    action: \"useActivity\",\n    targetUuid: turnEnd.targetUuid\n  });\n\n  await MidiQOL.socket().executeAsGM(\"setupRegion\", {\n    regionUuid: region.uuid,\n    update: {\n      behaviors: [{\n        _id: behavior.id,\n        system: { rules }\n      }]\n    }\n  });\n}"
        },
