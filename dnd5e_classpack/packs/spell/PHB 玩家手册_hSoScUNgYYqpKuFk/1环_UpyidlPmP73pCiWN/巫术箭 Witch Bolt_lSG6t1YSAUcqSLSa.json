{
  "_id": "lSG6t1YSAUcqSLSa",
  "name": "巫术箭 Witch Bolt",
  "type": "spell",
  "flags": {
    "midi-qol": {
      "fumbleThreshold": null,
      "rollAttackPerTarget": "always",
      "removeAttackDamageButtons": "default",
      "itemCondition": "",
      "effectCondition": "",
      "reactionCondition": "",
