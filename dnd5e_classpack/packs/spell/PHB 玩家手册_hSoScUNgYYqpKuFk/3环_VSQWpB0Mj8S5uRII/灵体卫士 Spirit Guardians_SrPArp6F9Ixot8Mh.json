        "macroData": {
          "name": "灵体卫士免疫名单与区域",
          "command": "const cfg = workflow.item.flags.dnd5e_classpack.regionAutomation;\nconst pass = args[0]?.macroPass;\nfunction ownEffect(effect, role) {\n  if (effect.flags?.dnd5e_classpack?.regionEffect !== role) return false;\n  const itemUuid = workflow.item.uuid;\n  return [effect.origin, ...Object.values(effect.system?.origin ?? {}),\n    effect._stats?.duplicateSource, effect.flags?.dnd5e_classpack?.sourceItemUuid]\n    .some(uuid => typeof uuid === \"string\" &&\n      (uuid === itemUuid || uuid.startsWith(itemUuid + \".\")));\n}\nfunction concentration() {\n  return MidiQOL.getConcentrationEffect(workflow.actor, workflow.item)\n    ?? MidiQOL.getConcentrationEffect(workflow.actor);\n}\nif (pass === \"preItemRoll\") {\n  const seen = new Set();\n  const rows = Array.from(canvas.tokens?.placeables ?? []).filter(token => token.actor &&\n    (token.isVisible ?? token.visible ?? false) && !seen.has(token.actor.uuid) && seen.add(token.actor.uuid));\n  const escapeHTML = value => String(value ?? \"\").replace(/[&<>\"']/g, char =>\n    ({ \"&\":\"&amp;\", \"<\":\"&lt;\", \">\":\"&gt;\", '\"':\"&quot;\", \"'\":\"&#39;\" })[char]);\n  const content = \"<p>选择本次灵体卫士不影响的生物。</p>\" + rows.map((token, index) =>\n    '<label style=\"display:block\"><input type=\"checkbox\" name=\"exempt\" value=\"' + index + '\"' +\n    (token.actor.uuid === workflow.actor.uuid ? \" checked\" : \"\") + '> ' + escapeHTML(token.name) + '</label>'\n  ).join(\"\");\n  const result = await foundry.applications.api.DialogV2.wait({\n    window: { title: \"灵体卫士：不受影响的生物\" }, content, rejectClose: false,\n    buttons: [{ action: \"cast\", label: \"施法\", default: true,\n      callback: (_event, _button, dialog) => Array.from(\n        dialog.element.querySelectorAll('input[name=\"exempt\"]:checked'))\n        .map(input => rows[Number(input.value)].actor.uuid)\n    }, { action: \"cancel\", label: \"取消\", callback: () => null }]\n  });\n  if (!Array.isArray(result)) return false;\n  workflow._spiritExemptActorUuids = result;\n}\nif (pass === \"templatePlaced\") {\n  const repeated = workflow.item.system.activities.get(cfg.repeated);\n  if (!repeated) throw new Error(\"区域重复活动不存在\");\n  for (const uuid of workflow.templateUuids ?? []) {\n    const region = await fromUuid(uuid);\n    if (region?.documentName !== \"Region\") continue;\n    const behavior = region.behaviors.find(b => b.type === \"midi-qol.regionActivity\" &&\n      b.system.sourceItemUuid === workflow.item.uuid && !b.flags?.dnd5e_classpack?.regionPassive);\n    if (!behavior) throw new Error(\"Midi 区域行为不存在\");\n    const rules = foundry.utils.deepClone(behavior.system.rules);\n    if (!rules.some(r => r.trigger === \"entry\" && r.action === \"useActivity\" && r.targetUuid === repeated.uuid)) {\n      rules.push({ trigger: \"entry\", action: \"useActivity\", targetUuid: repeated.uuid });\n    }\n    const extra = [];\n    if (cfg.terrain && !region.behaviors.some(b => b.type === \"dnd5e.difficultTerrain\")) {\n      extra.push({ name: workflow.item.name + \"：困难地形\", type: \"dnd5e.difficultTerrain\",\n        system: { magical: true, types: [], ignoredDispositions: [] } });\n    }\n    if (cfg.key === \"spiritGuardians\" && !region.behaviors.some(b =>\n      b.flags?.dnd5e_classpack?.regionPassive === \"spirit-slow\")) {\n      const enter = workflow.item.system.activities.get(cfg.slowEnter);\n      const exit = workflow.item.system.activities.get(cfg.slowExit);\n      if (!enter || !exit) throw new Error(\"灵体卫士减速活动不存在\");\n      extra.push({ name: \"灵体卫士：减速进出\", type: \"midi-qol.regionActivity\",\n        flags: { dnd5e_classpack: { regionPassive: \"spirit-slow\" } },\n        system: { sourceItemUuid: workflow.item.uuid, sourceActorUuid: workflow.actor.uuid,\n          castLevel: workflow.spellLevel ?? workflow.item.system.level,\n          dispositionFilter: 0, excludeSource: false, oncePerTurn: false, wallRestriction: \"none\",\n          rules: [{ trigger: \"entry\", action: \"useActivity\", targetUuid: enter.uuid },\n            { trigger: \"exit\", action: \"useActivity\", targetUuid: exit.uuid }] }\n      });\n    }\n    await MidiQOL.socket().executeAsGM(\"setupRegion\", {\n      regionUuid: region.uuid,\n      update: {\n        \"flags.dnd5e_classpack.regionAutomation\": { key: cfg.key, sourceItemUuid: workflow.item.uuid,\n          exemptActorUuids: workflow._spiritExemptActorUuids ?? [] },\n        behaviors: [{ _id: behavior.id, system: { rules } }]\n      }, behaviors: extra\n    });\n  }\n}\n"
        },
