        "macroData": {
          "name": "灵体卫士：进入减速",
          "command": "const cfg = workflow.item.flags.dnd5e_classpack.regionAutomation;\nconst pass = args[0]?.macroPass;\nfunction ownEffect(effect, role) {\n  if (effect.flags?.dnd5e_classpack?.regionEffect !== role) return false;\n  const itemUuid = workflow.item.uuid;\n  return [effect.origin, ...Object.values(effect.system?.origin ?? {}),\n    effect._stats?.duplicateSource, effect.flags?.dnd5e_classpack?.sourceItemUuid]\n    .some(uuid => typeof uuid === \"string\" &&\n      (uuid === itemUuid || uuid.startsWith(itemUuid + \".\")));\n}\nfunction concentration() {\n  return MidiQOL.getConcentrationEffect(workflow.actor, workflow.item)\n    ?? MidiQOL.getConcentrationEffect(workflow.actor);\n}\nif (pass !== \"preActiveEffects\") return;\nconst leaving = workflow.activity.id === cfg.slowExit;\nfor (const target of workflow.targets ?? []) {\n  const actor = target.actor;\n  if (!actor) continue;\n  const effects = Array.from(actor.appliedEffects ?? actor.effects);\n  const existing = effects.filter(effect =>\n    effect.flags?.dnd5e_classpack?.spiritSlow?.sourceItemUuid === workflow.item.uuid);\n  if (leaving) {\n    if (existing.length) await MidiQOL.removeEffects({ actorUuid: actor.uuid,\n      effects: existing.map(effect => effect.id) });\n    continue;\n  }\n  const scene = (target.document ?? target).parent;\n  const region = Array.from(scene?.regions ?? []).find(r =>\n    r.flags?.dnd5e_classpack?.regionAutomation?.sourceItemUuid === workflow.item.uuid);\n  if (!region || region.flags.dnd5e_classpack.regionAutomation.exemptActorUuids.includes(actor.uuid)) continue;\n  if (existing.length) continue;\n  const template = workflow.item.effects.get(cfg.slowEffect);\n  if (!template) throw new Error(\"灵体卫士减速效果不存在\");\n  const data = template.toObject();\n  delete data._id; delete data.start; delete data.origin;\n  data.transfer = false;\n  data.duration = { value: 10, units: \"minutes\", expiry: \"turnStart\" };\n  data.system.origin = { item: workflow.item.uuid, activity: workflow.activity.uuid };\n  data.flags ??= {}; data.flags.dnd5e_classpack ??= {};\n  data.flags.dnd5e_classpack.spiritSlow = { sourceItemUuid: workflow.item.uuid, regionUuid: region.uuid };\n  const dependentOn = concentration()?.uuid;\n  if (dependentOn) { data.flags.dnd5e ??= {}; data.flags.dnd5e.dependentOn = dependentOn; }\n  await MidiQOL.socket().executeAsGM(\"createEffects\", { actorUuid: actor.uuid, effects: [data] });\n}\n"
