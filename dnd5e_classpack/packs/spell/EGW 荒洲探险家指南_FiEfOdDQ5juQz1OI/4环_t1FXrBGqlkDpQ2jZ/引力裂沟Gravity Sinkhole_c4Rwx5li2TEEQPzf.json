    "dae": {
      "macro": {
        "name": "引力裂沟Gravity Sinkhole",
        "img": "icons/magic/air/air-burst-spiral-blue-gray.webp",
        "type": "script",
        "scope": "global",
        "command": "return await (async () => {\n  const api = globalThis.dnd5eClasspack;\n  if (!api?.push) return ui.notifications.warn(\"请先启用 ClassPack。\");\n  const choice = await api.dialog(\"强制位移\", \"\", [\n    [\"selectOption\", [{ label: \"参考点\", name: \"mode\", options: { options: [\n      { value: \"caster\", label: \"施法者\" }, { value: \"region\", label: \"选中的 Region 或最近的 Region\" },\n      { value: \"point\", label: \"手动选择\" }\n    ] } }]],\n    [\"selectOption\", [{ label: \"方向\", name: \"direction\", options: { options: [\n      { value: \"away\", label: \"远离\" }, { value: \"toward\", label: \"靠近\" }\n    ] } }]],\n    [\"number\", [{ label: \"距离（场景单位）\", name: \"distance\", options: { currentValue: 15 } }]],\n    [\"selectOption\", [{ label: \"目标\", name: \"targets\", options: { options: [\n      { value: \"targets\", label: \"已 target 的 Token\" }, { value: \"controlled\", label: \"控制的 Token（除施法者）\" }\n    ] } }]],\n    [\"selectOption\", [{ label: \"动画\", name: \"animate\", options: { options: [\n      { value: \"yes\", label: \"播放\" }, { value: \"no\", label: \"不播放\" }\n    ] } }]]\n  ], \"okCancel\");\n  if (!choice?.buttons) return;\n  const distance = Number(choice.distance);\n  if (!Number.isFinite(distance) || distance <= 0) return ui.notifications.warn(\"请输入大于零的距离。\");\n  const caster = canvas.tokens.controlled[0] ?? (typeof token === \"undefined\" ? null : token);\n  let origin;\n  if (choice.mode === \"caster\") {\n    if (!caster) return ui.notifications.warn(\"请先控制施法者的 Token。\");\n    origin = caster;\n  } else if (choice.mode === \"region\") {\n    const regions = Array.from(canvas.scene.regions).filter(region => region.object?.visible);\n    const selected = canvas.regions.controlled[0]?.document;\n    origin = selected ?? regions.sort((a, b) => (b._stats?.createdTime ?? 0) - (a._stats?.createdTime ?? 0))[0];\n    if (!origin || origin.shapes.length !== 1) {\n      ui.notifications.info(\"未找到单一形状的 Region，请手动选择参考点。\");\n      origin = null;\n    }\n  }\n  if (!origin) {\n    const point = await api.Crosshairs.showCrosshairs({ timeout: 20000, label: \"选择参考点\" });\n    if (point.cancelled || !point.valid) return;\n    origin = point;\n  }\n  const targets = choice.targets === \"targets\" ? Array.from(game.user.targets ?? [])\n    : canvas.tokens.controlled.filter(target => target.id !== caster?.id);\n  if (!targets.length) return ui.notifications.warn(\"请选择要移动的目标。\");\n  const result = await api.push(targets, origin, choice.direction === \"away\" ? distance : -distance,\n    { animate: choice.animate === \"yes\", avoidOccupied: true, checkCollision: true });\n  for (const target of targets) {\n    if (result[target.id] !== true) ui.notifications.warn(target.name + \" 的位移未完成或被阻挡。\");\n  }\n  return result;\n})();\n",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
