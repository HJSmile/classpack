    "dae": {
      "macro": {
        "name": "真龙姿态 Draconic Presence",
        "type": "script",
        "command": "if (workflow.activity?.identifier !== \"save-for-dragon\") return;\nconst helperUuid = workflow.workflowOptions?.overTimeEffectUuid;\nconst helper = helperUuid ? await fromUuid(helperUuid) : null;\nconst sourceUuid = helper?.flags.auraeffects?.fromAura;\nconst source = sourceUuid ? await fromUuid(sourceUuid) : null;\nif (!source) return false;\nconst caster = source.actor ?? source.parent;\nconst mode = source.flags.dnd5e_classpack.draconicMode;\nconst now = game.time.worldTime;\nconst immune = actor => actor.appliedEffects.some(effect => !effect.disabled && !effect.isSuppressed\n  && effect.flags.dnd5e_classpack?.draconicImmunity?.actorUuid === caster.uuid\n  && effect.flags.dnd5e_classpack.draconicImmunity.expiresAt > now);\nif (args[0]?.macroPass === \"preItemRoll\") {\n  if ([...workflow.targets].every(target => immune(target.actor))) return false;\n  const value = source._source.system.changes.find(c => c.key === \"flags.dnd5e_classpack.draconicDC\")?.value;\n  const dc = foundry.dice.Roll.safeEval(String(value));\n  Object.assign(workflow.activity.save.dc, { calculation: \"\", formula: String(dc), value: dc });\n  return;\n}\nif (args[0]?.macroPass !== \"postSave\") return;\nfor (const target of workflow.saves) {\n  const lingering = target.actor.appliedEffects.filter(effect =>\n    effect.flags.dnd5e_classpack?.draconicCondition?.actorUuid === caster.uuid);\n  if (lingering.length) await MidiQOL.socket().executeAsGM(\"removeEffects\", {\n    actorUuid: target.actor.uuid, effects: lingering.map(effect => effect.id)\n  });\n  if (immune(target.actor)) continue;\n  await MidiQOL.socket().executeAsGM(\"createEffects\", {\n    actorUuid: target.actor.uuid,\n    effects: [{ name: `${macroItem.name}：免疫`, img: macroItem.img, type: \"base\", transfer: false,\n      origin: macroItem.uuid, statuses: [],\n      duration: { value: 24, units: \"hours\", expiry: null },\n      system: { changes: [], magical: false, origin: { actor: caster.uuid, item: macroItem.uuid } },\n      flags: { dnd5e_classpack: { draconicImmunity: { actorUuid: caster.uuid, expiresAt: now + 86400 } } }\n    }]\n  });\n}\nfor (const target of workflow.failedSaves) {\n  if (immune(target.actor)) continue;\n  const existing = target.actor.appliedEffects.some(effect => !effect.disabled && !effect.isSuppressed\n    && effect.flags.dnd5e_classpack?.draconicCondition?.sourceUuid === source.uuid);\n  if (existing) continue;\n  const template = macroItem.effects.find(effect => effect.flags.dnd5e_classpack?.draconicConditionTemplate === mode);\n  const data = template.toObject();\n  delete data._id; delete data._key;\n  data.origin = macroItem.uuid;\n  data.duration = { value: Math.max(1, (source.start?.time ?? now) + 60 - now), units: \"seconds\", expiry: null };\n  data.system.origin = { actor: caster.uuid, item: macroItem.uuid, effect: source.uuid };\n  data.flags.dnd5e ??= {};\n  data.flags.dnd5e.dependentOn = source.uuid;\n  data.flags.dnd5e_classpack.draconicCondition = { actorUuid: caster.uuid, sourceUuid: source.uuid };\n  await MidiQOL.socket().executeAsGM(\"createEffects\", { actorUuid: target.actor.uuid, effects: [data] });\n}\n"
      }
