    "dae": {
      "macro": {
        "name": "熵光结界 Entropic Ward",
        "type": "script",
        "command": "const pass = args[0]?.macroPass;\nconst dataKey = Symbol.for(\"dnd5e_classpack.entropicWard.rollData\");\nif (pass === \"preActiveEffects\") {\n  const attacker = workflow.targets.first()?.actor;\n  if (!attacker) return;\n  const sourceItem = workflow.workflowOptions?.sourceItemUuid;\n  const interrupted = sourceItem ? MidiQOL.Workflow.getWorkflow(sourceItem) : null;\n  const ward = { workflowId: interrupted?.id ?? \"\", attackerUuid: attacker.uuid };\n  const previous = workflow.item[dataKey] ?? workflow.item.getRollData;\n  workflow.item[dataKey] = previous;\n  workflow.item.getRollData = function (...options) { return { ...previous.apply(this, options), ward }; };\n  return;\n}\nif (pass === \"postActiveEffects\" && workflow.item[dataKey]) {\n  workflow.item.getRollData = workflow.item[dataKey];\n  delete workflow.item[dataKey];\n  return;\n}\nif (pass !== \"postActiveEffects\" || !workflow.attackRoll) return;\nconst context = MidiQOL.createConditionData({ workflow, actor: workflow.actor, target: workflow.targets.first() });\nconst effects = workflow.actor.appliedEffects.filter(effect => {\n  const role = effect.flags.dnd5e_classpack?.entropicWard;\n  if (!role || effect.disabled || effect.isSuppressed) return false;\n  const key = role === \"ward\" ? \"flags.midi-qol.disadvantage.attack.all\" : \"flags.midi-qol.advantage.attack.all\";\n  const change = effect.system.changes.find(c => c.key === key);\n  return change && MidiQOL.evalCondition(change.value, context, { errorReturn: false });\n});\nfor (const effect of effects) {\n  if (effect.flags.dnd5e_classpack.entropicWard === \"ward\") {\n    const protectedActor = macroItem.actor;\n    const protectedTokens = [...workflow.targets].filter(t => t.actor?.uuid === protectedActor?.uuid);\n    if (protectedActor && protectedTokens.length && protectedTokens.every(t => !workflow.hitTargets.has(t))) {\n      const template = macroItem.effects.find(e => e.flags.dnd5e_classpack?.entropicWard === \"counter\");\n      const data = template.toObject();\n      delete data._id; delete data._key;\n      data.origin = macroItem.uuid;\n      data.system.origin = { item: macroItem.uuid, actor: protectedActor.uuid };\n      data.system.changes.find(c => c.key === \"flags.midi-qol.advantage.attack.all\").value =\n        `targetActorUuid === ${JSON.stringify(workflow.actor.uuid)}`;\n      await MidiQOL.socket().executeAsGM(\"createEffects\", { actorUuid: protectedActor.uuid, effects: [data] });\n    }\n  }\n  await MidiQOL.socket().executeAsGM(\"removeEffects\", {\n    actorUuid: workflow.actor.uuid, effects: [effect.id], options: { \"expiry-reason\": \"midi-qol:entropicWardAttack\" }\n  });\n}\n"
      }
    }
  },
