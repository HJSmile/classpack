    "chris-premades": {
      "info": {
        "identifier": "maneuversFeintingAttack",
        "source": "chris-premades",
        "version": "0.0.0"
      }
    },
    "dae": {
      "macro": {
        "name": "战技: 诡诈攻击 Maneuvers: Feinting Attack",
        "type": "script",
        "command": "const pass = args[0]?.macroPass;\nconst dataKey = Symbol.for(\"dnd5e_classpack.feint.rollData\");\nif (pass === \"preActiveEffects\") {\n  const target = workflow.targets.first();\n  if (!target?.actor) return;\n  const previous = workflow.item[dataKey] ?? workflow.item.getRollData;\n  workflow.item[dataKey] = previous;\n  workflow.item.getRollData = function (...options) {\n    return { ...previous.apply(this, options), feint: { targetActorUuid: target.actor.uuid } };\n  };\n  return;\n}\nif (pass === \"postActiveEffects\" && workflow.item[dataKey]) {\n  workflow.item.getRollData = workflow.item[dataKey];\n  delete workflow.item[dataKey];\n  return;\n}\nif (![\"isAttacked\", \"postActiveEffects\"].includes(pass) || !workflow.attackRoll) return;\nconst holders = pass === \"isAttacked\" ? [...workflow.targets].map(t => t.actor) : [workflow.actor];\nfor (const holder of holders.filter(Boolean)) {\n  const effects = holder.appliedEffects.filter(effect => {\n    if (effect.disabled || effect.isSuppressed) return false;\n    const role = effect.flags.dnd5e_classpack?.feint;\n    if (role !== (pass === \"isAttacked\" ? \"mark\" : \"damage\")) return false;\n    const key = role === \"mark\" ? \"flags.midi-qol.grants.advantage.attack.all\" : \"flags.midi-qol.optional.诡诈攻击.activation\";\n    const change = effect.system.changes.find(c => c.key === key);\n    const target = role === \"mark\" ? workflow.token : workflow.targets.first();\n    return change && MidiQOL.evalCondition(change.value,\n      MidiQOL.createConditionData({ workflow, actor: workflow.actor, target }), { errorReturn: false });\n  });\n  if (effects.length) await MidiQOL.socket().executeAsGM(\"removeEffects\", {\n    actorUuid: holder.uuid, effects: effects.map(e => e.id), options: { \"expiry-reason\": \"midi-qol:feintAttack\" }\n  });\n}\n"
      }
    }
  },
