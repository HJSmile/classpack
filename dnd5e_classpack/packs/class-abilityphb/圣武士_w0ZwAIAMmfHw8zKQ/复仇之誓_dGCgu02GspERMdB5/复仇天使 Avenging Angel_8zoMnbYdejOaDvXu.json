        "macroData": {
          "name": "Midi Use",
          "command": "const activityId = \"threat-aura-activate\";\nconst saveId = \"threat-aura-save\";\n\nif (workflow.activity.midiProperties.identifier !== activityId) return;\n\nif (workflow.macroPass === \"preActiveEffects\") {\n  const sourceToken = workflow.token;\n  if (!sourceToken) return;\n\n  const saveActivity = workflow.item.system.activities.find(\n    a => a.type === 'save'\n  );\n  if (!saveActivity) return;\n\n  const targets = MidiQOL.findNearby(-1, sourceToken, 30, {\n    includeToken: false,\n    includeIncapacitated: true,\n    relative: true\n  }).filter(t => t.actor);\n\n  workflow.threatAuraInitialTargets =\n    targets.map(t => t.actor.uuid);\n\n  if (!targets.length) return;\n\n  await MidiQOL.completeActivityUse(\n    saveActivity,\n    {\n      midiOptions: {\n        targetUuids: targets.map(t => t.document.uuid),\n        ignoreUserTargets: true,\n        workflowOptions: {\n          noOnUseMacro: true,\n        }\n      }\n    },\n    { configure: false },\n    { create: true }\n  );\n}\n\nelse if (workflow.macroPass === \"postActiveEffects\") {\n  const aura = workflow.actor.effects.find(\n    effect =>\n      effect.type === \"auraeffects.aura\" &&\n      effect.getFlag(\"dae\", \"activity\") === workflow.activity.uuid\n  );\n\n  if (!aura) return;\n\n  const initialTargets = workflow.threatAuraInitialTargets ?? [];\n\n  // 等待 Aura Effects 创建初始子效果\n  for (let i = 0; i < 40; i++) {\n    const ready = initialTargets.every(actorUuid => {\n      const actor = fromUuidSync(actorUuid);\n      return actor?.effects.some(e => e.origin === aura.uuid);\n    });\n\n    if (ready) break;\n    await new Promise(resolve => setTimeout(resolve, 50));\n  }\n\n  await aura.update({\n    \"flags.dae.threatAuraInitial\": false\n  });\n}"
        },
