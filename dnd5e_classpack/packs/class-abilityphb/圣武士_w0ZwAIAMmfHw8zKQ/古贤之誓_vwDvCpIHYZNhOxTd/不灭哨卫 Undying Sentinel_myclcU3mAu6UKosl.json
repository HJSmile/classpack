        "name": "不灭哨卫 Undying Sentinel",
        "img": "modules/dnd5e_classpack/Nicons/Ability_Paladin_HolyAvenger.png",
        "type": "script",
        "scope": "global",
        "command": "if (macroItem.system.uses.value == 0) return;\nconst ditem = workflow.damageItem;\nif (ditem.newHP > 0 || !ditem.isHit) return;\nawait classpack.dialogUtils.confirm(macroItem.name, '是否使用不灭哨卫的使用次数，将生命值降至1点而不是0点',{ userId: classpack.firstOwner(macroItem.actor) })\nawait macroItem.update({\n  'system.uses.spent' : +1\n})\nditem.totalDamage = ditem.oldHP - 1;\nditem.newHP = 1;\nditem.newTempHP = 0;\nditem.hpDamage = ditem.totalDamage;\nditem.damageDetail.forEach(i => i.value = 0);\nditem.damageDetail[0].value = ditem.totalDamage;",
