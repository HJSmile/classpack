    "dae": {
      "macro": {
        "name": "引导神力：驱散无信者 Channel Divinity: Turn the Faithless",
        "img": "icons/magic/holy/barrier-shield-winged-cross.webp",
        "type": "script",
        "scope": "global",
        "command": "// FilterTargets: 从当前选中的 targets 中移除非不死生物（优先读取 actor.system.details.type.value）\n(async () => {\n  const targets = Array.from(game.user.targets);\n  if (!targets.length) return ui.notifications.warn(\"请先选中一个或多个目标（使用 Target 工具），然后再运行此宏。\");\n\n  // 可靠读取 creature type 的函数，优先用 actor.system.details.type.value\n  function readCreatureType(actor) {\n    if (!actor) return null;\n    // 优先路径（与你提供的输出一致）\n    const primary = actor?.system?.details?.type?.value ?? actor?.system?.details?.type;\n    if (typeof primary === \"string\" && primary.trim()) return primary.trim().toLowerCase();\n    // 回退至 prototypeToken.actorData（如果存在）\n    const proto = actor?.prototypeToken?.actorData?.details?.type?.value ?? actor?.prototypeToken?.actorData?.details?.type;\n    if (typeof proto === \"string\" && proto.trim()) return proto.trim().toLowerCase();\n    // 进一步回退：getRollData 也可能包含 details\n    if (typeof actor.getRollData === \"function\") {\n      try {\n        const rd = actor.getRollData();\n        const rdType = rd?.details?.type;\n        if (typeof rdType === \"string\" && rdType.trim()) return rdType.trim().toLowerCase();\n      } catch (e) { /* ignore */ }\n    }\n    return null;\n  }\n\n  const removed = [];\n  const kept = [];\n\n  for (const t of targets) {\n    try {\n      // t 可能是 Canvas Token 或 TokenDocument 或其他。尽力解析到 canvas Token 和 actor\n      let token = null;\n      if (t?.document && canvas.tokens.get(t.id)) token = canvas.tokens.get(t.id);\n      else if (t?.id && canvas.tokens.get(t.id)) token = canvas.tokens.get(t.id);\n      else token = t; // 也有可能已经是 canvas token\n\n      // 最终确保拿到 actor\n      const actor = token?.actor ?? (await fromUuid(token?.actor?.uuid).catch(()=>null)) ?? null;\n      if (!actor) {\n        console.warn(\"无法解析目标 actor：\", t);\n        continue;\n      }\n\n      const ctype = readCreatureType(actor); // e.g. \"undead\", \"humanoid\"\n      const isUndead = !!ctype && (ctype.includes(\"fiend\") || ctype.includes(\"fey\"));\n      if (!isUndead) {\n        // 取消目标：优先用 canvas token 的 setTarget 方法\n        try {\n          if (token && typeof token.setTarget === \"function\") {\n            token.setTarget(false, { user: game.user.id });\n          } else {\n            // 回退：删除 game.user.targets 中的条目\n            game.user.targets.delete(t);\n            // 另一回退：尝试找画布上对应 token 并取消\n            const canvasToken = canvas.tokens.placeables.find(p => p.actor?.id === actor.id);\n            if (canvasToken && typeof canvasToken.setTarget === \"function\") canvasToken.setTarget(false, { user: game.user.id });\n          }\n        } catch (e) {\n          // 最终回退：直接从 Set 中删除\n          try { game.user.targets.delete(t); } catch(e2) { /* ignore */ }\n        }\n        removed.push(actor.name ?? token?.name ?? t?.id);\n      } else {\n        kept.push(actor.name ?? token?.name ?? t?.id);\n      }\n    } catch (err) {\n      console.error(\"处理目标时出错：\", err);\n    }\n  }\n\n  // 输出结果\n  const removedText = removed.length ? removed.join(\", \") : \"（无）\";\n  const keptText = kept.length ? kept.join(\", \") : \"（无）\";\n})();",
        "author": "WqWGW8MuBm7BNHxt",
