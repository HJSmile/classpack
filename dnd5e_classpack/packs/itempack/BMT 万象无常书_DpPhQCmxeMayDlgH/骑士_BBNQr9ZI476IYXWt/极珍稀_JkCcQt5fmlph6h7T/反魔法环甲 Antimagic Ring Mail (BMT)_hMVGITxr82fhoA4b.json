{
  "_id": "hMVGITxr82fhoA4b",
  "name": "反魔法环甲 Antimagic Ring Mail (BMT)",
  "type": "equipment",
  "system": {
    "source": {
      "custom": "",
      "book": "BMT",
      "page": "65",
