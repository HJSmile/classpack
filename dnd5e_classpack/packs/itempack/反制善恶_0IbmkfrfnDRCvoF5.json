    "dnd5e": {},
    "dae": {
      "macro": {
        "name": "反制善恶",
        "img": "icons/magic/holy/barrier-shield-winged-blue.webp",
        "type": "script",
        "scope": "global",
        "command": "// dae-remove-dispel\n// 通用 DAE 宏：当 DAE 效果被移除时 (args[0] === \"off\")，\n// 检查该效果的宿主 actor 并删除名为 \"反制善恶\" / \"Dispel Evil and Good\" 的 ActiveEffect（如果存在）。\n\n(async () => {\n  try {\n    console.log(\"🧩 dae-remove-dispel: args:\", args);\n\n    const mode = args[0]; // DAE 会传 \"on\" / \"off\" / \"each\" 等\n    // 只在效果被删除（off）时处理\n    if (mode !== \"off\" && mode !== \"remove\") {\n      // 有些版本/用法会给 \"off\" 或 \"remove\"，但通常是 \"off\"\n      console.log(\"🧩 dae-remove-dispel: non-off mode, skip:\", mode);\n      return;\n    }\n\n    // args 的最后一项通常包含关于触发上下文的信息（tokenId / origin 等）\n    const last = args.at?.(-1) ?? args[args.length - 1] ?? {};\n    // 尝试通过 tokenId 或 actorId 找到 actor（兼容不同 DAE/Foundry 版本）\n    const tokenId = last.tokenId ?? last.token?.id;\n    const actorId = last.actorId ?? last.actor?.id;\n    const actor = (tokenId ? canvas.tokens.get(tokenId)?.actor : null) || (actorId ? game.actors.get(actorId) : null) || (last.actor ? last.actor : null);\n\n    if (!actor) {\n      console.warn(\"🧩 dae-remove-dispel: 无法定位 actor（args 最后一项）：\", last);\n      return;\n    }\n\n    console.log(`🧩 dae-remove-dispel: 触发于 actor ${actor.name} (mode=${mode})`);\n\n    // 查找名为 \"反制善恶\" 或 \"Dispel Evil and Good\" 的效果（忽略大小写、支持中文/英文）\n    const targetEf = actor.effects.find(e => /反制善恶|Dispel Evil and Good/i.test(e.label ?? \"\"));\n    if (!targetEf) {\n      console.log(\"🧩 dae-remove-dispel: 目标 actor 上未发现 '反制善恶 Dispel Evil and Good' 效果\");\n      return;\n    }\n\n    // 删除它（使用 Actor 的 API）\n    await actor.deleteEmbeddedDocuments(\"ActiveEffect\", [targetEf.id]);\n    console.log(`🧩 dae-remove-dispel: 已删除效果: ${targetEf.label} (id=${targetEf.id})`);\n\n    // 可选：发送聊天提示\n    ChatMessage.create({\n      content: `${actor.name} 的效果 <strong>${targetEf.label}</strong> 因使用了驱逐或是解除附魔已被自动移除.`,\n      speaker: ChatMessage.getSpeaker({ actor })\n    });\n\n  } catch (err) {\n    console.error(\"🧩 dae-remove-dispel: 错误：\", err);\n    ui.notifications.error(\"dae-remove-dispel 宏执行出错，查看控制台以获取详情\");\n  }\n})();",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
