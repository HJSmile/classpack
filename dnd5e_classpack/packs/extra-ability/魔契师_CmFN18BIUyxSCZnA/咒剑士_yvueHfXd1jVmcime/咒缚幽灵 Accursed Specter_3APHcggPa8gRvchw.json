{
  "_id": "3APHcggPa8gRvchw",
  "name": "咒缚幽灵 Accursed Specter",
  "type": "feat",
  "img": "icons/creatures/magical/spirit-undead-ghost-purple.webp",
  "system": {
    "type": {
