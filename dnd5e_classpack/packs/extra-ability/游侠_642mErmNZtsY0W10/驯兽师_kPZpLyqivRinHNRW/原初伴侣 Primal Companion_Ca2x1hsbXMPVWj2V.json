{
  "_id": "Ca2x1hsbXMPVWj2V",
  "name": "原初伴侣 Primal Companion",
  "type": "feat",
  "img": "icons/creatures/mammals/spirit-deer-herd-blue.webp",
  "system": {
    "type": {
      "value": "class",
