    "dae": {
      "macro": {
        "name": "引导神力：驱散异域 Channel Divinity： Abjure The Extraplanar.",
        "img": "icons/magic/holy/barrier-shield-winged-cross.webp",
        "type": "script",
        "scope": "global",
        "command": "// Abjure the Extraplanar – Channel Divinity macro\n// Foundry v12.331 + dnd5e v4.3.9\n// Requires: Midi-QOL, DAE\n\nif (!token) return ui.notifications.warn(\"Select your token.\");\n\nconst caster = token.actor;\nconst saveDC = caster.system.attributes.spelldc;\nconst DIST = 30;\nconst VALID = [\"aberration\", \"celestial\", \"elemental\", \"fey\", \"fiend\"];\n\n// 1️⃣ Find your Channel Divinity item on the caster\nconst cdItem = caster.items.find(i => i.name === \"引导神力：驱散异域 Channel Divinity： Abjure The Extraplanar.\");\nif (!cdItem) return ui.notifications.error(\"No 'Channel Divinity' item found.\");\n\n// 2️⃣ Pick the correct embedded effect on that item\n//    (for example: the third effect—adjust index as needed)\nconst itemEffectData = cdItem.effects.contents[0]; \nif (!itemEffectData) return ui.notifications.error(\"The item has no effects to apply.\");\n\n// 3️⃣ Prepare the effect data to apply later\nconst baseEffectData = itemEffectData.toObject();\ndelete baseEffectData._id;\n\n// 4️⃣ Locate targets within range\nconst targets = canvas.tokens.placeables.filter(t => {\n  if (!t.actor || t === token) return false;\n  if (t.actor.system.attributes.hp.value <= 0) return false;\n  if (!VALID.includes(t.actor.system.details.type.value)) return false;\n  return canvas.grid.measureDistance(token, t) <= DIST;\n});\n\nif (!targets.length) {\n  return ChatMessage.create({ content: \"No valid extraplanar creatures within 30 ft.\" });\n}\n\nlet chatHtml = `<h2>${caster.name} uses Abjure the Extraplanar</h2><ul>`;\n\nfor (let tgt of targets) {\n  // Skip actors who already have the effect\n  const existing = tgt.actor.effects.find(e => e.origin === cdItem.uuid && e.label === baseEffectData.label);\n  if (existing) {\n    chatHtml += `<li>${tgt.name}: ❌ Already has ${baseEffectData.label}</li>`;\n    continue;\n  }\n\n  const roll = await tgt.actor.rollAbilitySave(\"wis\", { chatMessage: false, fastForward: true });\n  const failed = roll.total < saveDC;\n  chatHtml += `<li>${tgt.name}: ${failed ? \"❌ Failed\" : \"✅ Success\"} (rolled ${roll.total} vs DC ${saveDC})</li>`;\n\n  if (failed) {\n    // Clone effect, set new origin, and apply\n    const eff = duplicate(baseEffectData);\n    eff.origin = cdItem.uuid;\n    await tgt.actor.createEmbeddedDocuments(\"ActiveEffect\", [eff]);\n  }\n}\n\nchatHtml += \"</ul>\";\nChatMessage.create({ content: chatHtml });",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
