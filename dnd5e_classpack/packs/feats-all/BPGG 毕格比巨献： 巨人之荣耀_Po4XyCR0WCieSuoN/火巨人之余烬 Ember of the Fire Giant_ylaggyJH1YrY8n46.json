{
  "name": "火巨人之余烬 Ember of the Fire Giant",
  "type": "feat",
  "system": {
    "source": {
      "custom": "",
      "book": "BPGG",
      "page": "17",
      "license": "",
      "revision": 1,
      "rules": "2014"
